# VPS 部署环境变量示例（复制为 .env，放在 /opt/zhixu/.env）
PORT=80
PORT2=8080
HOST=0.0.0.0
WJ_LLM_API_KEY=your-spark-api-key
WJ_LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
WJ_LLM_MODEL=spark-x2.6-4b
WJ_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# AI 接口限流：每 IP 每小时次数
ZHIXU_RATE_PER_HOUR=60
# 是否启用分享收件箱（VPS 版）
ZHIXU_INBOX=1
# 收件箱鉴权（可选）
WJ_INBOX_TOKEN=

.hero {
  padding: 10rpx 4rpx 26rpx;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}

.hero-title {
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--ink);
}

.hero-title .em {
  color: var(--orange-deep);
  font-style: normal;
  border-bottom: 6rpx solid var(--orange-soft);
}

.hero-lede {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.small {
  font-size: 22rpx;
}

.text-link {
  font-size: 24rpx;
  color: var(--orange-deep);
  padding: 4rpx 0 4rpx 20rpx;
}

.url-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.url-input {
  flex: 1;
  min-width: 0;
}

.note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--orange-soft);
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--orange-deep);
}

.steps {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 20rpx;
}

.step {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  padding: 12rpx 6rpx;
  background: #f7efe4;
  border-radius: 10rpx;
}

.step.on {
  background: var(--sage-soft);
  color: #4f6a55;
}

.block {
  width: 100%;
  margin-top: 6rpx;
}

.textarea-sm {
  min-height: 140rpx;
}

.field-row {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.field-col {
  flex: 1;
  min-width: 0;
}

.picker {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  font-size: 27rpx;
  color: var(--ink);
}

.archive-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  background: #f7efe4;
  border-radius: var(--radius-sm);
}

.foot-note {
  margin-top: 30rpx;
  font-size: 21rpx;
  text-align: center;
  line-height: 1.6;
}
